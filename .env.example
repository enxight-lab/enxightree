# K-RE MAP 배치 빌더(scripts/build_data.py)용 환경변수
# 실제 .env 는 절대 커밋 금지 (.gitignore 등록됨). 키는 배치(로컬/GitHub Actions Secrets)에서만 사용,
# 클라이언트(브라우저)로는 절대 노출하지 않는다 — 산출물 public/data.json 만 배포된다.

# 공공데이터포털 data.go.kr — 국토교통부 아파트 매매 실거래가 OpenAPI
DATA_GO_API_KEY=

# 한국부동산원 reb.or.kr / R-ONE 통계 OpenAPI — 매매가격지수
REP_API_KEY=

# (2d 단계 — 뉴스 연동. 정식 보관처는 CF Worker 환경변수, 여기는 로컬 테스트용)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
